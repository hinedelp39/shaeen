<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect /login-type to /login-type/ (for trailingSlash support)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # Serve the index.html or the specific page.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
